---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import { lookupOutcome } from '../../lib/lookup';
import StructuredData from '../../components/StructuredData.astro';
import UserProfile from '../../pages-react/UserProfile.jsx';
import { supabase } from '../../supabaseClient';
import { buildProfilePageSchema, buildBreadcrumbSchema, metaDescription } from '../../lib/seo';

const { handle } = Astro.params;

let profile = null;
// 'unknown' until a lookup answers definitively; only 'missing' becomes a 404.
let outcome = 'unknown';
try {
  const isTest = typeof process !== 'undefined' && process.env.PLAYWRIGHT_TEST === 'true';
  if (supabase && handle && !isTest) {
    const result = await supabase
      .from('profiles')
      .select('display_name, bio')
      .eq('handle', handle)
      .maybeSingle();
    profile = result.data;
    outcome = lookupOutcome(result);
  }
} catch (e) {
  console.error('Error fetching user profile details for SEO:', e);
}

// A record that definitely doesn't exist gets a real 404 and stays out of search results.
const notFound = outcome === 'missing';
if (notFound) Astro.response.status = 404;

const displayName = profile?.display_name || `@${handle}`;
const title = `${displayName} | Horror Writer`;
const description = metaDescription(profile?.bio, { fallback: `${displayName}'s horror stories and critiques on Horror Writer.` });
const siteUrl = Astro.site ? new URL(Astro.site).origin : 'https://horrorwriter.org';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const profileSchema = buildProfilePageSchema({ url: pageUrl, name: displayName });
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: `${siteUrl}/` },
  { name: 'Writers', url: `${siteUrl}/forum/` },
  { name: displayName, url: pageUrl }
]);
---

<MainLayout noindex={notFound} title={title} description={description}>
  <StructuredData data={breadcrumbSchema} />
  <StructuredData data={profileSchema} />
  <UserProfile handle={handle} client:load />
</MainLayout>

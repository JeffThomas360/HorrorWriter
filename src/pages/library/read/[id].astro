---
export const prerender = false;

import MainLayout from '../../../layouts/MainLayout.astro';
import { lookupOutcome } from '../../../lib/lookup';
import StructuredData from '../../../components/StructuredData.astro';
import ReadStory from '../../../pages-react/ReadStory.jsx';
import { supabase } from '../../../supabaseClient';
import { buildCreativeWorkSchema, buildBreadcrumbSchema, metaDescription } from '../../../lib/seo';
import { ARCHIVE_STORIES } from '../../../lib/seedArchives';

const { id } = Astro.params;

let book = null;
// 'unknown' until a lookup answers definitively; only 'missing' becomes a 404.
let outcome = 'unknown';
const archiveMatch = ARCHIVE_STORIES.find(a => a.id === id);

if (archiveMatch) {
  outcome = 'found';
  book = {
    title: archiveMatch.title,
    lede: archiveMatch.lede,
    created_at: archiveMatch.created_at,
    profiles: {
      handle: archiveMatch.profiles?.display_name || archiveMatch.profiles?.handle || 'Classic Author'
    }
  };
} else {
  try {
    const isTest = typeof process !== 'undefined' && process.env.PLAYWRIGHT_TEST === 'true';
    if (supabase && !isTest) {
      const result = await supabase
        .from('books')
        .select('title, lede, created_at, profiles(handle)')
        .eq('id', id)
        .maybeSingle();
      book = result.data;
      outcome = lookupOutcome(result);
    }
  } catch (e) {
    console.error('Error fetching book details for SEO:', e);
  }
}

// A record that definitely doesn't exist gets a real 404 and stays out of search results.
const notFound = outcome === 'missing';
if (notFound) Astro.response.status = 404;

const authorHandle = book?.profiles?.handle || 'Unknown';
const title = book ? `${book.title} by ${authorHandle} | Horror Writer` : 'Story | Horror Writer';
const description = book
  ? metaDescription(book.lede, { fallback: `A horror story by ${authorHandle} on Horror Writer.` })
  : 'Read horror stories and dark fiction on Horror Writer.';
const ogImage = `/og/story/${id}.png`;
const siteUrl = Astro.site ? new URL(Astro.site).origin : 'https://horrorwriter.org';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

const creativeWorkSchema = book ? buildCreativeWorkSchema({
  url: pageUrl,
  title: book.title,
  description: book.lede,
  authorName: authorHandle,
  datePublished: book.created_at,
  type: 'ShortStory',
  // Authors keep all rights; the public-domain archive classics claim none.
  copyrightYear: archiveMatch || !book.created_at ? undefined : new Date(book.created_at).getUTCFullYear()
}) : null;

const breadcrumbSchema = book ? buildBreadcrumbSchema([
  { name: 'Home', url: `${siteUrl}/` },
  { name: 'The Library', url: `${siteUrl}/library/` },
  { name: book.title, url: pageUrl }
]) : null;
---

<MainLayout noindex={notFound} title={title} description={description} ogImage={ogImage}>
  {breadcrumbSchema && <StructuredData data={breadcrumbSchema} />}
  {creativeWorkSchema && <StructuredData data={creativeWorkSchema} />}
  <ReadStory id={id} client:load />
</MainLayout>

---
export const prerender = false;

import MainLayout from '../../../layouts/MainLayout.astro';
import StructuredData from '../../../components/StructuredData.astro';
import ThreadView from '../../../pages-react/ThreadView.jsx';
import { supabase } from '../../../supabaseClient';
import { buildDiscussionForumPostingSchema, buildBreadcrumbSchema } from '../../../lib/seo';

const { id } = Astro.params;

let thread = null;
try {
  const isTest = typeof process !== 'undefined' && process.env.PLAYWRIGHT_TEST === 'true';
  if (supabase && !isTest) {
    const { data } = await supabase
      .from('threads')
      .select('title, created_at, profiles(handle)')
      .eq('id', id)
      .single();
    thread = data;
  }
} catch (e) {
  console.error('Error fetching thread for SEO:', e);
}

const authorHandle = thread?.profiles?.handle || 'Unknown Author';
const title = thread ? `${thread.title} — The Crypt | Horror Writer` : 'Thread — The Crypt | Horror Writer';
const description = thread ? `A discussion started by ${authorHandle} in The Crypt, the horror writing forum on Horror Writer.` : 'Horror writing discussion in The Crypt on Horror Writer.';
const siteUrl = Astro.site ? new URL(Astro.site).origin : 'https://horrorwriter.org';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

const postingSchema = thread ? buildDiscussionForumPostingSchema({
  url: pageUrl,
  headline: thread.title,
  authorName: authorHandle,
  datePublished: thread.created_at
}) : null;

const breadcrumbSchema = thread ? buildBreadcrumbSchema([
  { name: 'Home', url: `${siteUrl}/` },
  { name: 'The Crypt Forum', url: `${siteUrl}/forum` },
  { name: thread.title, url: pageUrl }
]) : null;
---

<MainLayout title={title} description={description}>
  {breadcrumbSchema && <StructuredData data={breadcrumbSchema} />}
  {postingSchema && <StructuredData data={postingSchema} />}
  <ThreadView id={id} client:load />
</MainLayout>

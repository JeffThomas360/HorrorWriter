---
export const prerender = false;

import MainLayout from '../../../layouts/MainLayout.astro';
import { lookupOutcome } from '../../../lib/lookup';
import StructuredData from '../../../components/StructuredData.astro';
import ThreadView from '../../../pages-react/ThreadView.jsx';
import { supabase } from '../../../supabaseClient';
import { buildDiscussionForumPostingSchema, buildBreadcrumbSchema } from '../../../lib/seo';
import { isPlaywrightTest } from '../../../lib/testMode';

const { id } = Astro.params;

let thread = null;
let initialPosts = undefined;
// 'unknown' until a lookup answers definitively; only 'missing' becomes a 404.
let outcome = 'unknown';
try {
  if (supabase && !isPlaywrightTest()) {
    const result = await supabase
      .from('threads')
      .select('*, profiles(handle), categories(name), ritual_prompts(id, body, goes_live_at)')
      .eq('id', id)
      .maybeSingle();
    thread = result.data;
    outcome = lookupOutcome(result);
    // First page of posts, so the writing is in the HTML Google first sees
    // (same query and page size as ThreadView's first page).
    if (thread && !thread.removed_by_author) {
      const posts = await supabase
        .from('posts')
        .select('*, profiles(handle)')
        .eq('thread_id', id)
        .order('created_at', { ascending: true })
        .range(0, 14);
      if (!posts.error) initialPosts = posts.data || [];
    }
  }
} catch (e) {
  console.error('Error fetching thread for SEO:', e);
}

// A record that definitely doesn't exist gets a real 404 and stays out of search results.
const notFound = outcome === 'missing';
if (notFound) Astro.response.status = 404;

const isTombstone = Boolean(thread?.removed_by_author);
const isRitual = Boolean(thread?.ritual_prompts?.body);
const authorHandle = thread?.profiles?.handle || (isRitual ? 'Horror Writer' : 'Unknown Author');
const promptSnippet = isRitual
  ? (thread.ritual_prompts.body.length > 110 ? `${thread.ritual_prompts.body.slice(0, 107).trimEnd()}…` : thread.ritual_prompts.body)
  : '';
// A Ritual thread's title is the whole prompt (up to 200 chars), too long for a
// title tag; lead with what people search for and a short cut of the prompt.
const ritualTitleCut = isRitual
  ? (thread.ritual_prompts.body.length > 60 ? `${thread.ritual_prompts.body.slice(0, 57).trimEnd()}…` : thread.ritual_prompts.body)
  : '';
const title = isTombstone
  ? 'Removed by its author | Horror Writer'
  : isRitual ? `Horror Writing Prompt: ${ritualTitleCut} | Horror Writer`
  : thread ? `${thread.title} — The Crypt | Horror Writer` : 'Thread — The Crypt | Horror Writer';
const description = isRitual
  ? `Horror flash fiction written to the Midnight Ritual prompt "${promptSnippet}", with critique, on Horror Writer.`
  : thread ? `A discussion started by ${authorHandle} in The Crypt, the horror writing forum on Horror Writer.` : 'Horror writing discussion in The Crypt on Horror Writer.';
const siteUrl = Astro.site ? new URL(Astro.site).origin : 'https://horrorwriter.org';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

const postingSchema = thread && !isTombstone ? buildDiscussionForumPostingSchema({
  url: pageUrl,
  headline: thread.title,
  authorName: authorHandle,
  datePublished: thread.created_at
}) : null;

const breadcrumbSchema = thread && !isTombstone ? buildBreadcrumbSchema([
  { name: 'Home', url: `${siteUrl}/` },
  isRitual
    ? { name: 'Horror Writing Prompts', url: `${siteUrl}/prompts/` }
    : { name: 'The Crypt Forum', url: `${siteUrl}/forum/` },
  { name: thread.title, url: pageUrl }
]) : null;
---

<MainLayout noindex={notFound || isTombstone} title={title} description={description}>
  {breadcrumbSchema && <StructuredData data={breadcrumbSchema} />}
  {postingSchema && <StructuredData data={postingSchema} />}
  <ThreadView id={id} initialThread={thread && !isTombstone ? thread : undefined} initialPosts={initialPosts} client:load />
</MainLayout>

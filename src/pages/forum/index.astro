---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import Forum from '../../pages-react/Forum.jsx';
import { fetchForumDirectory } from '../../lib/forumDirectory';
import { threadPath } from '../../lib/urls';
import { isPlaywrightTest } from '../../lib/testMode';

// The forum is a client-rendered island, so this list is what a crawler can
// follow to the threads. A failed lookup just leaves it out.
let directory = null;
try {
  if (!isPlaywrightTest()) directory = await fetchForumDirectory();
} catch (e) {
  console.error('Error fetching the forum directory:', e);
}
---

<MainLayout title="The Crypt — Horror Writing Forum | Horror Writer" description="A horror writing forum and critique group: craft discussion, novel feedback, market calls and genre theory for serious horror writers.">
  <Forum client:load />
  {directory && directory.length > 0 && (
    <nav aria-labelledby="all-threads" class="mt-16 max-w-3xl mx-auto">
      <h2 id="all-threads" class="font-mono text-xs uppercase tracking-[0.25em] text-[var(--color-text-secondary)] mb-6">▸ Browse every thread</h2>
      <div class="flex flex-col gap-8">
        {directory.map((c) => (
          <section>
            <h3 class="font-serif text-lg font-bold mb-3">{c.label}</h3>
            <ul class="flex flex-col gap-1 font-serif text-[var(--color-text-secondary)]">
              {c.threads.map((t) => (
                <li><a href={threadPath(t.id)} class="inline-block py-1 hover:text-[var(--color-ember)] hover:underline">{t.title}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </nav>
  )}
</MainLayout>

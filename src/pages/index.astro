---
import MainLayout from '../layouts/MainLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import MidnightRitual from '../components/MidnightRitual.jsx';
import WitchingHourBar from '../components/WitchingHourBar.jsx';
import DreadDiagnostic from '../components/DreadDiagnostic.jsx';
import VoidWhispers from '../components/VoidWhispers.jsx';
import { supabase } from '../supabaseClient';
import { buildWebSiteSchema, buildFAQSchema } from '../lib/seo';

const faqs = [
  {
    question: "What is Horror Writer?",
    answer: "Horror Writer (horrorwriter.org) is an independent circle and community for serious dark fiction authors. It offers constructive critique in The Crypt, retro VHS cassette publishing in The Library, and sensory flash fiction writing challenges."
  },
  {
    question: "Who owns the copyright to stories published on Horror Writer?",
    answer: "You retain 100% of your copyright. By publishing on Horror Writer, you only grant a non-exclusive display license to show your work to members. You can edit or delete your stories at any time."
  },
  {
    question: "How does critique work in The Crypt?",
    answer: "Members critique under the core rule: 'Critique the art, respect the author.' Authors can tag their stories with specific feedback goals (opening hook, pacing, dread, or line edits) to receive genre-literate constructive criticism."
  },
  {
    question: "What is The Midnight Ritual writing challenge?",
    answer: "The Midnight Ritual is an interactive prompt receiver broadcasting weekly and instant micro-fiction prompts across cosmic dread, analog horror, folk occult, and psychological terror. Writers can answer prompts directly in an instant 250-word flash writing terminal."
  }
];

const websiteSchema = buildWebSiteSchema({
  url: 'https://horrorwriter.org',
  name: 'Horror Writer — Dark Fiction Community, Critique & Writing Prompts',
  description: 'A circle for serious horror writers — forums, critique, and craft.'
});

const faqSchema = buildFAQSchema(faqs);

const FALLBACK_TILES = [
  {
    tag: '▸ CRITIQUE',
    title: 'How do you write quiet horror?',
    body: 'A discussion on dread without a body count — the slow architecture of unease.',
    meta: 'Start the conversation',
  },
  {
    tag: '▸ WORKSHOP',
    title: 'First page, no mercy',
    body: 'Drop the first 250 words. We tell you whether we kept reading. And why we stopped.',
    meta: 'Be the first to post',
  },
  {
    tag: '▸ LIBRARY',
    title: 'New shorts this week',
    body: 'Fresh pieces from the coven — left in the dark for others to find.',
    meta: 'Read the library',
  },
];

const WHY = [
  {
    ic: 'I.',
    label: 'No algorithm',
    body: 'Chronological. Hand-curated. The best work rises because readers say so — not because a feed decided.',
  },
  {
    ic: 'II.',
    label: 'Real critique',
    body: 'A Critique Code every member agrees to. Praise is cheap; we deal in useful. Cruelty is shown the door.',
  },
  {
    ic: 'III.',
    label: 'No ads. Ever.',
    body: 'Run by hand, not by advertisers. Your attention is not for sale. Your work is not the product.',
  },
];

let tiles = FALLBACK_TILES;

try {
  const isTest = typeof process !== 'undefined' && process.env.PLAYWRIGHT_TEST === 'true';
  if (supabase && !isTest) {
    const { data } = await supabase
      .from('threads')
      .select('*, categories(name), profiles(handle)')
      .order('updated_at', { ascending: false })
      .limit(3);

    if (data && data.length > 0) {
      tiles = data.map((t, i) => ({
        tag: `▸ ${(t.categories?.name || 'THREAD').split('·')[0].toUpperCase().trim()}`,
        hot: i === 0,
        title: t.title,
        body: `Started by @${t.profiles?.handle || 'someone'}. Join the discussion in the dark.`,
        meta: `${t.replies_count || 0} replies`,
        id: t.id,
      }));
    }
  }
} catch (e) {
  console.error('Error fetching dynamic stats/threads during build:', e);
}

const [heroTile, ...restTiles] = tiles;
const isFallback = tiles === FALLBACK_TILES;
---

<MainLayout title="Horror Writer — Dark Fiction Community, Critique & Writing Prompts" description="The premier community for serious horror writers. Receive ruthless craft critique in The Crypt, share stories in vintage VHS sleeves, and answer daily dark fiction writing prompts.">
  <StructuredData data={websiteSchema} />
  <StructuredData data={faqSchema} />

  <!-- The Witching Hour Status Bar -->
  <WitchingHourBar client:load />

  <!-- Hero Section — "Late Signal": public-access-TV register, teal + red CRT double-image title -->
  <section
    class="relative border-b border-[var(--color-line)] pb-16 mb-16 pt-10 px-6 -mx-6 overflow-hidden"
    style="background:
      radial-gradient(ellipse 900px 500px at 85% -10%, rgba(25,165,184,0.14), transparent 60%),
      radial-gradient(ellipse 700px 450px at 0% 110%, rgba(200,16,46,0.12), transparent 60%);"
  >
    <div class="flex justify-between items-center mb-10">
      <span class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-text-secondary)]">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-ember)] shadow-[0_0_8px_var(--color-ember)]" aria-hidden="true"></span>
        On Air — Members Only
      </span>
      <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-upside)] border border-[var(--color-upside)] px-3 py-1">
        Ch. 13
      </span>
    </div>

    <h1
      class="text-4xl md:text-6xl font-serif font-black leading-none tracking-tight text-[var(--color-text-primary)] max-w-4xl mb-6"
      style="text-shadow: -3px 0 0 rgba(25,165,184,0.55), 3px 0 0 rgba(200,16,46,0.5);"
    >
      Write the things <br />
      <span class="italic">that keep them up.</span>
    </h1>
    <p class="text-base md:text-lg font-serif italic text-[var(--color-text-secondary)] max-w-2xl mb-8 leading-relaxed">
      A circle for serious horror writers — forums, critique,
      and a coven that takes the craft as seriously as you do.
    </p>

    <div class="flex flex-wrap gap-6 items-center">
      <!--
        The signed-out CTA is the DEFAULT rendered state and must work with no
        JavaScript at all. `cta-enter` is swapped in by the script below only
        once a session is actually confirmed.

        Do NOT mark both of these `hidden` by default. Any JS failure then
        leaves the landing page with no primary call to action at all — which
        is precisely what the 2026-09-06 CSP outage produced: every visitor got
        a hero with only the outline "Read the Library" button.
      -->
      <button id="cta-join" class="border border-[var(--color-upside)] text-[var(--color-upside)] font-mono text-xs uppercase px-6 py-3.5 tracking-wider shadow-[0_0_20px_rgba(25,165,184,0.25)] hover:bg-[var(--color-upside)] hover:text-[var(--color-void)] transition-colors cursor-pointer">
        Join the Coven
      </button>
      <a id="cta-enter" href="/forum" class="hidden border border-[var(--color-upside)] text-[var(--color-upside)] font-mono text-xs uppercase px-6 py-3.5 tracking-wider shadow-[0_0_20px_rgba(25,165,184,0.25)] hover:bg-[var(--color-upside)] hover:text-[var(--color-void)] transition-colors">
        Enter the Crypt
      </a>
      <a href="/library" class="font-mono text-xs uppercase tracking-wider text-[var(--color-text-secondary)] hover:text-[var(--color-ember)] transition-colors">
        Read the Library →
      </a>
    </div>
  </section>

  <!-- The Midnight Ritual: Interactive Flash Prompt Terminal -->
  <MidnightRitual client:load />

  <!-- The Dread Spectrum: Horror Archetype Psychological Diagnostic -->
  <DreadDiagnostic client:load />

  <!-- Content Grid Section -->
  <section class="mb-20">
    <div class="flex justify-between items-end mb-8">
      <div>
        {isFallback ? (
          <>
            <span class="block font-mono text-xs uppercase tracking-[0.25em] text-[var(--color-upside)] mb-2">The Crypt · Founded this year</span>
            <h2 class="text-2xl md:text-3xl font-serif font-black">Nothing here yet. <em class="italic text-[var(--color-ember)] font-serif">That's the point.</em></h2>
            <p class="font-serif text-sm text-[var(--color-text-secondary)] max-w-lg mt-3 leading-relaxed">
              Every long-running forum you love was empty once. The threads you start tonight are the ones new members find in a year — with your name on them.
            </p>
          </>
        ) : (
          <>
            <span class="block font-mono text-xs uppercase tracking-[0.25em] text-[var(--color-text-secondary)] mb-2">In the Crypt right now</span>
            <h2 class="text-2xl md:text-3xl font-serif font-black">The <em class="italic text-[var(--color-accent-crimson)] font-serif">conversations</em> tonight</h2>
          </>
        )}
      </div>
      <a href="/forum" class="hidden sm:inline-block font-mono text-xs hover:text-[var(--color-accent-crimson)] transition-colors border-b border-[var(--color-line)] pb-1">All threads →</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Hero Tile (Large) -->
      <a href={heroTile.id ? `/forum/thread/${heroTile.id}` : '/forum'} class="md:col-span-2 vintage-card relative flex flex-col justify-between hover:border-white transition-all min-h-[260px]">
        <div>
          <div class="flex justify-between items-start mb-4">
            <span class="font-mono text-xs tracking-wider text-[var(--color-text-secondary)] font-bold">{heroTile.tag}</span>
            {heroTile.hot && <span class="font-mono text-xs bg-[var(--color-accent-crimson)] text-white px-1.5 py-0.5 animate-pulse">TRENDING</span>}
          </div>
          <h3 class="text-xl font-serif font-bold mb-3 hover:text-[var(--color-accent-crimson)] transition-colors">{heroTile.title}</h3>
          <p class="text-sm font-serif text-[var(--color-text-secondary)] leading-relaxed max-w-xl">{heroTile.body}</p>
        </div>
        <span class="block font-mono text-xs text-[var(--color-text-secondary)] mt-6 uppercase tracking-wider">{heroTile.meta}</span>
      </a>

      <!-- Sub stack tiles -->
      <div class="flex flex-col gap-6">
        {restTiles.map((t) => (
          <a href={t.id ? `/forum/thread/${t.id}` : '/forum'} class="vintage-card flex-1 flex flex-col justify-between hover:border-white transition-all min-h-[120px]">
            <div>
              <span class="block font-mono text-xs tracking-wider text-[var(--color-text-secondary)] mb-2 font-bold">{t.tag}</span>
              <h3 class="text-base font-serif font-bold mb-2 leading-snug hover:text-[var(--color-accent-crimson)] transition-colors">{t.title}</h3>
            </div>
            <span class="block font-mono text-xs text-[var(--color-text-secondary)] mt-4 uppercase tracking-wider">{t.meta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Whispers in the Void: Anonymous Dread Confessional & Story Seeds -->
  <VoidWhispers client:load />

  <!-- Why Section -->
  <section class="max-w-4xl mx-auto mb-12">
    <span class="block font-mono text-xs uppercase tracking-[0.25em] text-[var(--color-upside)] mb-2 text-center">Why this place</span>
    <h2 class="text-2xl md:text-3xl font-serif font-black text-center mb-12">For writers who <em class="italic text-[var(--color-ember)] font-serif">mean it.</em></h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {WHY.map((w) => (
        <div class="flex flex-col gap-3">
          <div class="font-serif font-black text-2xl text-[var(--color-upside)] italic">{w.ic}</div>
          <h3 class="text-base font-serif font-bold tracking-tight text-[var(--color-text-primary)]">{w.label}</h3>
          <p class="text-sm font-serif text-[var(--color-text-secondary)] leading-relaxed">{w.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ Section for Search Discoverability -->
  <section class="max-w-4xl mx-auto mb-20 border-t border-[var(--color-line)] pt-16">
    <span class="block font-mono text-xs uppercase tracking-[0.25em] text-[var(--color-upside)] mb-2 text-center">Inquiries</span>
    <h2 class="text-2xl md:text-3xl font-serif font-black text-center mb-10">Frequently Asked <em class="italic text-[var(--color-ember)] font-serif">Questions</em></h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {faqs.map((faq) => (
        <div class="vintage-card p-6 flex flex-col justify-between">
          <h3 class="text-base font-serif font-bold text-[var(--color-text-primary)] mb-3 leading-snug">
            {faq.question}
          </h3>
          <p class="text-xs font-serif text-[var(--color-text-secondary)] leading-relaxed">
            {faq.answer}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Closing CTA — the page finally asks -->
  <section
    class="text-center py-20 px-6 -mx-6 mb-4"
    style="background: radial-gradient(ellipse 700px 400px at 50% 100%, rgba(25,165,184,0.14), transparent 70%);"
  >
    <h2 class="text-2xl md:text-3xl font-serif font-black mb-4">Be one of the first names in the dark.</h2>
    <p class="font-serif italic text-[var(--color-text-secondary)] text-base mb-9">
      No cost. No algorithm deciding who sees you. Just a coven and a blank page.
    </p>
    <button id="cta-join-closing" class="border border-[var(--color-upside)] text-[var(--color-upside)] font-mono text-xs uppercase px-8 py-4 tracking-wider shadow-[0_0_20px_rgba(25,165,184,0.25)] hover:bg-[var(--color-upside)] hover:text-[var(--color-void)] transition-colors cursor-pointer">
      Join the Coven — Founding Member
    </button>
  </section>

</MainLayout>

<script>
  // Progressive enhancement only. "Join the Coven" is rendered visible from the
  // server and is the correct CTA for the signed-out majority of landings; this
  // merely *upgrades* it to "Enter the Crypt" once a Supabase session is
  // confirmed. Every failure path — missing env var, unavailable localStorage,
  // a thrown error, or this script never executing at all — must leave the
  // signed-out CTA standing. Never make the visible CTA depend on JS running.
  const upgradeCtaForSession = () => {
    try {
      const url = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.VITE_SUPABASE_URL;
      if (!url) return;
      const storageKey = 'sb-' + url.split('//')[1].split('.')[0] + '-auth-token';
      if (!localStorage.getItem(storageKey)) return;

      document.getElementById('cta-join')?.classList.add('hidden');
      document.getElementById('cta-enter')?.classList.remove('hidden');
    } catch (e) {
      // Deliberately silent: the signed-out CTA is already visible.
    }
  };

  upgradeCtaForSession();

  // Listen to custom signin clicks
  document.getElementById('cta-join')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-signin'));
  });
  document.getElementById('cta-join-closing')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-signin'));
  });
</script>

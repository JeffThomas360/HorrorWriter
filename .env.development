# `npm run dev` only. Vite ranks .env.development above .env.local, so the dev server talks to
# the local Supabase stack (`npx supabase start`) and never to production. Builds and the
# Workers preview use .env.production / Workers Builds variables and are unaffected.
# The key is the Supabase CLI's public local-demo anon key: it only works against 127.0.0.1.
# If it stops working after a CLI upgrade, copy the anon / publishable key from `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_ENABLE_GOOGLE_LOGIN=false
